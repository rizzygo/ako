rules_version = '2';
// Regras do Cloud Firestore do projeto rizzygo-webapp, usado pelo Ako e pelo site.
// O projeto tem um arquivo de regras só: este junta as do Ako (users/<uid>/apps/<app>), o
// cadastro de leitores dos ebooks do site (leitores/<uid>) e o admin (contas, planos, revisoes). Se mudar um lado, copie o outro igual.
// Para publicar: console do Firebase > Firestore Database > Regras > colar este arquivo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Ako: cada pessoa lê e grava só os próprios documentos. 'ako' junta trilhas, mapas e ajustes
    // (desde 11/11/2026); os três antigos continuam liberados para quem ainda está com a versão anterior.
    match /users/{uid}/apps/{app} {
      function valido() {
        let d = request.resource.data;
        return app in ['rotina', 'ako', 'trilhas', 'mapas', 'ajustes']
          && d.keys().hasOnly(['dados', 'cliente', 'aceites', 'versao', 'atualizadoEm'])
          && d.dados is string && d.dados.size() < 900000
          && d.cliente is int
          && d.aceites is map && d.aceites.keys().hasOnly(['saude', 'reflexoes'])
          && d.versao == 1
          && d.atualizadoEm == request.time;
      }
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && valido();
    }

    // Site: cadastro de quem lê os ebooks. O e-mail tem de ser o da conta logada,
    // e a data do aceite e o ebook de origem não mudam depois de criados.
    match /leitores/{uid} {
      function campos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nome', 'email', 'novidades', 'origem', 'versao', 'aceiteEm', 'atualizadoEm'])
          && d.nome is string && d.nome.size() <= 120
          && d.email == request.auth.token.email
          && d.novidades is bool
          && d.origem is string && d.origem.size() <= 100
          && d.versao == 1
          && d.atualizadoEm == request.time;
      }
      allow read, delete: if dono(uid);
      allow create: if dono(uid) && campos() && request.resource.data.aceiteEm == request.time;
      allow update: if dono(uid) && campos()
        && request.resource.data.aceiteEm == resource.data.aceiteEm
        && request.resource.data.origem == resource.data.origem;
    }

    // Admin: só quem tem um documento em admins/<uid>, criado à mão no console. Nenhum uid fica no código.
    // O admin não lê users/<uid>/apps: o que a pessoa guarda continua só dela.
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function dia(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A página do admin confere se a conta é admin lendo o próprio documento. Ninguém grava por aqui.
    match /admins/{uid} {
      allow read: if dono(uid);
    }

    // Contas logadas, para o admin contar e saber de quem é cada conta. A pessoa grava só o próprio
    // documento, no máximo uma vez por dia por app (nuvem.js), e não lê o de ninguém.
    match /contas/{uid} {
      function conta() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'emailVerificado', 'nome', 'criadaEm', 'vistaEm', 'apps', 'versao'])
          && (d.email == request.auth.token.email || (d.email == null && request.auth.token.email == null))
          // Quem cria conta com e-mail e senha pode digitar o e-mail de outra pessoa: o admin vê se foi conferido.
          && d.emailVerificado == (request.auth.token.email_verified == true)
          && (d.nome == null || (d.nome is string && d.nome.size() <= 120))
          && dia(d.vistaEm)
          && d.apps is map && d.apps.keys().hasOnly(['ako', 'rotina'])
          && (!('ako' in d.apps) || dia(d.apps.ako))
          && (!('rotina' in d.apps) || dia(d.apps.rotina))
          && d.versao == 1;
      }
      allow read: if admin();
      allow delete: if dono(uid);
      allow create: if dono(uid) && conta() && request.resource.data.criadaEm == request.time;
      allow update: if dono(uid) && conta() && request.resource.data.criadaEm == resource.data.criadaEm;
    }

    // Plano de cada conta (grátis ou Zumi+). A pessoa só lê o próprio plano; quem grava é o admin
    // (e, mais tarde, o Worker do pagamento, que usa service account e não passa por estas regras).
    // Apagar a conta apaga o plano junto.
    match /planos/{uid} {
      function plano() {
        let d = request.resource.data;
        return d.keys().hasOnly(['plano', 'origem', 'ciclo', 'validoAte', 'atualizadoEm', 'atualizadoPor'])
          && d.plano in ['gratis', 'zumi+']
          && d.origem in ['manual', 'pagamento', 'vitalicio']
          && (d.ciclo == null || d.ciclo in ['mensal', 'anual'])
          && (d.validoAte == null || d.validoAte is timestamp)
          && d.atualizadoEm == request.time
          && d.atualizadoPor == request.auth.token.email;
      }
      allow read: if dono(uid) || admin();
      allow delete: if dono(uid) || admin();
      allow create, update: if admin() && plano();

      // Cada troca de plano vira uma linha. Só o admin vê; ninguém edita uma linha depois de criada.
      match /historico/{id} {
        allow read: if admin();
        allow create: if admin()
          && request.resource.data.keys().hasOnly(['de', 'para', 'origem', 'validoAte', 'quando', 'quem'])
          && request.resource.data.quando == request.time
          && request.resource.data.quem == request.auth.token.email;
      }
    }

    // Só do admin: nota sobre cada conta (a pessoa lê o plano, por isso a nota fica fora dele)
    // e o check da revisão de cada conteúdo do Ako.
    match /anotacoes/{uid} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['texto', 'atualizadoEm'])
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && request.resource.data.atualizadoEm == request.time;
    }
    match /revisoes/{id} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['status', 'nota', 'hash', 'titulo', 'revisadoEm'])
        && request.resource.data.status in ['ok', 'ajustar', 'pendente']
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 2000
        && request.resource.data.hash is string && request.resource.data.hash.size() <= 64
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
        && request.resource.data.revisadoEm == request.time;
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
